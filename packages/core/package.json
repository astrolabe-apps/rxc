{
  "name": "@rx-controls/core",
  "version": "1.0.0",
  "description": "Reactive control tree for form and application state — explicit reads and writes, no globals, zero dependencies.",
  "keywords": [
    "controls",
    "reactive",
    "forms",
    "state-management",
    "typescript",
    "validation"
  ],
  "author": "Astrolabe Enterprises",
  "license": "ISC",
  "homepage": "https://github.com/astrolabe-apps/rxc/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrolabe-apps/rxc.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/astrolabe-apps/rxc/issues"
  },
  "type": "module",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "default": "./lib/internal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vitest": "~3.1.0",
    "fast-check": "~4.6.0",
    "prettier": "^3.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
