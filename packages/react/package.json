{
  "name": "@rx-controls/react",
  "version": "1.0.0",
  "description": "React bindings for @rx-controls/core — explicit reactive reads through a ReadContext, no compiler plugin, no globals.",
  "keywords": [
    "react",
    "react-hooks",
    "controls",
    "reactive",
    "forms",
    "state-management",
    "typescript",
    "validation"
  ],
  "author": "Astrolabe Enterprises",
  "license": "ISC",
  "homepage": "https://github.com/astrolabe-apps/rxc/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrolabe-apps/rxc.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/astrolabe-apps/rxc/issues"
  },
  "type": "module",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rx-controls/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "happy-dom": "~15.11.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "typescript": "~5.8.0",
    "vitest": "~3.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
