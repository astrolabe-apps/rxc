{
  "name": "@react-typed-forms/core",
  "version": "5.0.0",
  "description": "The v5 major of @react-typed-forms/core: the v4 API reimplemented on the @rx-controls engine. Upgrade is a semver bump plus one provider line.",
  "keywords": [
    "react",
    "typescript",
    "forms",
    "controls",
    "reactive",
    "state-management"
  ],
  "author": "Astrolabe Enterprises",
  "license": "ISC",
  "homepage": "https://github.com/astrolabe-apps/rxc/tree/main/packages/compat-controls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrolabe-apps/rxc.git",
    "directory": "packages/compat-controls"
  },
  "bugs": {
    "url": "https://github.com/astrolabe-apps/rxc/issues"
  },
  "type": "module",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rx-controls/core": "workspace:^",
    "@rx-controls/react": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "react": "~19.1.0",
    "typescript": "~5.8.0",
    "vitest": "~3.1.0",
    "@types/react-dom": "~19.1.0",
    "react-dom": "~19.1.0",
    "happy-dom": "~15.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
