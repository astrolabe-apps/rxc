{
  "name": "@rx-controls/forms-html",
  "version": "0.1.0-alpha.0",
  "description": "The Forms v2 HTML implementation: every registry slot drawn as plain DOM, every class it emits in one HtmlTheme, and nestable theme providers.",
  "author": "Astrolabe Enterprises",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrolabe-apps/rxc.git",
    "directory": "packages/forms-html"
  },
  "type": "module",
  "files": [
    "lib",
    "src"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/shared.d.ts",
      "default": "./lib/shared.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rx-controls/core": "workspace:^",
    "@rx-controls/react": "workspace:^",
    "@rx-controls/forms-react": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "happy-dom": "~15.11.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "typescript": "~5.8.0",
    "vitest": "~3.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
