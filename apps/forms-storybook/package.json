{
  "name": "rxc-forms-storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Forms v2 Storybook: a story per boundary kind, written against the contract, rendered under every implementation and theme.",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "tsc --noEmit && storybook build --quiet -o storybook-static",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fluentui/react-components": "^9.74.9",
    "@mui/material": "^9.4.0",
    "@rx-controls/core": "workspace:^",
    "@rx-controls/forms-antd": "workspace:^",
    "@rx-controls/forms-fluent": "workspace:^",
    "@rx-controls/forms-html": "workspace:^",
    "@rx-controls/forms-mui": "workspace:^",
    "@rx-controls/forms-native": "workspace:^",
    "@rx-controls/forms-react": "workspace:^",
    "@rx-controls/react": "workspace:^",
    "antd": "^6.6.4",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-native-web": "~0.21.0",
    "rxc-forms-conformance": "workspace:^"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/postcss": "~4.1.0",
    "@types/node": "~22.15.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "~15.11.0",
    "nativewind": "~4.2.3",
    "postcss": "~8.5.0",
    "react-native": "0.86.3",
    "storybook": "^10.6.1",
    "tailwindcss": "~4.1.0",
    "typescript": "~5.8.0",
    "vite": "^8.3.0",
    "vitest": "~3.1.0"
  }
}
